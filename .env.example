# cp .env.example .env 로 복사해서 쓴다 (.env 는 커밋하지 않는다).
# ⚠️ src 에서 읽는 VITE_* 값은 빌드 시 브라우저 번들에 그대로 들어간다. 시크릿/비밀키를 넣지 말 것.

# 프론트엔드가 호출할 API 주소 앞부분. dev 에서는 Vite 프록시(/api → VITE_PROXY_TARGET)를 탄다.
# 백엔드를 직접 가리키려면 http://localhost:8007/api 처럼 쓴다 (이때는 백엔드 CORS 설정이 필요하다).
VITE_API_BASE_URL=/api

# 업로드 이미지 주소 앞부분 (게시글 img 값 앞에 붙인다).
VITE_UPLOAD_BASE_URL=/uploads

# dev 서버 프록시 대상 (vite.config.ts 에서만 쓴다, 번들에 들어가지 않는다).
#   Go (basicproject_go)          http://localhost:8007  ← 기본
#   Spring (basicproject_springboot) http://localhost:8081
#   Rust (basicproject_rust)      http://localhost:8008
VITE_PROXY_TARGET=http://localhost:8007

# 관리자 레벨 (화면에서 관리자 메뉴를 보일지 정할 때만 쓴다). model.json 의 adminLevel 과 같게 둔다.
VITE_ADMIN_LEVEL=3
